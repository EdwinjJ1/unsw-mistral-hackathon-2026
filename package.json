{
  "name": "athena",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "bot:dev": "tsx --env-file-if-exists=.env bot/index.ts",
    "test": "npm run test:core && npm run test:mistral",
    "test:core": "tsx --test lib/*.test.ts bot/dispatch.test.ts",
    "test:mistral": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@mistralai/mistralai": "^2.5.0",
    "better-sqlite3": "12.11.1",
    "discord.js": "14.27.0",
    "next": "15.5.22",
    "officeparser": "^7.5.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.11",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
